files:
  "/etc/cron.d/cleanup_old_files":
    mode: "000644"
    owner: root
    group: root
    content: |
      # Clean up old files daily at 2 AM UTC
      0 2 * * * root /usr/bin/python3 /var/app/current/cleanup_old_files.py >> /var/log/cleanup.log 2>&1

commands:
  01_remove_old_cron:
    command: "rm -f /etc/cron.d/cleanup_old_files.bak"
  02_restart_cron:
    command: "service crond restart"